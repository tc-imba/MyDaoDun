// Horizontal gradient fill for cc.Label / cc.Sprite, outline-aware.
// Samples `gradientMap` left->right across the node's world X bounds and uses
// it as the body RGB. When the same label has cc.LabelOutline, the outline
// pixels in the glyph cache carry `outlineColor` and the body pixels carry
// `bodyColor`; the shader classifies each sampled pixel by which of those it
// is closer to (in RGB), so the outline keeps its original color while the
// body is repainted with the gradient. AA edges blend continuously via the
// distance ratio.
//
// Driven each frame by RainbowGradient.ts:
//  - `bounds` (x=worldLeft, y=worldRight) for the gradient sweep
//  - `bodyColor`    = Label.color    (the fill stored in the bitmap)
//  - `outlineColor` = LabelOutline.color (the stroke stored in the bitmap)
// If LabelOutline is absent, RainbowGradient pushes outlineColor=bodyColor;
// the shader then degenerates to "everything is body" (pure gradient).
CCEffect %{
  techniques:
  - passes:
    - vert: sprite-vs:vert
      frag: sprite-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        alphaThreshold: { value: 0.5 }
        gradientMap:    { value: white }
        bounds:         { value: [0.0, 1.0, 0.0, 0.0] }
        bodyColor:      { value: [1.0, 1.0, 1.0, 1.0], editor: { type: color } }
        outlineColor:   { value: [1.0, 1.0, 1.0, 1.0], editor: { type: color } }
}%

CCProgram sprite-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  #if SAMPLE_FROM_RT
    #include <common/common-define>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;

  out vec4 color;
  out vec2 uv0;
  out float v_gx;

  vec4 vert () {
    vec4 pos = vec4(a_position, 1);

    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif

    v_gx = pos.x;

    #if USE_PIXEL_ALIGNMENT
      pos = cc_matView * pos;
      pos.xyz = floor(pos.xyz);
      pos = cc_matProj * pos;
    #else
      pos = cc_matViewProj * pos;
    #endif

    uv0 = a_texCoord;
    #if SAMPLE_FROM_RT
      CC_HANDLE_RT_SAMPLE_FLIP(uv0);
    #endif
    color = a_color;

    return pos;
  }
}%

CCProgram sprite-fs %{
  precision highp float;
  #include <builtin/internal/embedded-alpha>
  #include <builtin/internal/alpha-test>

  in vec4 color;
  in vec2 uv0;
  in float v_gx;

  #pragma builtin(local)
  layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;

  uniform sampler2D gradientMap;
  uniform GradientParams {
    vec4 bounds;
    vec4 bodyColor;
    vec4 outlineColor;
  };

  vec4 frag () {
    vec4 src = CCSampleWithAlphaSeparated(cc_spriteTexture, uv0);

    float denom = max(0.0001, bounds.y - bounds.x);
    float t = clamp((v_gx - bounds.x) / denom, 0.0, 1.0);
    vec3 grad = texture(gradientMap, vec2(t, 0.5)).rgb;

    // Classify pixel as outline vs body by RGB closeness. Use a relative
    // weight so AA pixels (blended between the two colors) interpolate
    // smoothly. If body and outline colors are equal, the classifier is
    // undefined - default to body (pure gradient) so callers without a
    // LabelOutline get the original behavior.
    float colorSep = distance(bodyColor.rgb, outlineColor.rgb);
    float outlineDist = distance(src.rgb, outlineColor.rgb);
    float bodyDist = distance(src.rgb, bodyColor.rgb);
    float outlineWeight = colorSep < 0.01
        ? 0.0
        : bodyDist / (bodyDist + outlineDist + 0.0001);

    vec3 rgb = mix(grad, outlineColor.rgb, outlineWeight);

    // Preserve UIOpacity (carried in vertex color alpha) but do not tint RGB
    // by vertex color - the gradient texture / outlineColor uniform are the
    // sole sources of color, so a black Label.color (set by RainbowGradient
    // to keep the body sentinel distinct from the outline) does not zero out
    // the output.
    vec4 o = vec4(rgb, src.a * color.a);
    ALPHA_TEST(o);
    return o;
  }
}%
